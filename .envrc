dotenv_if_exists ../.env

git summary
git secrets --scan

echo
echo "git submodule status:"
git submodule status
echo

echo "snakemake --lt:"
snakemake --lt | grep -v "^ " | awk '{print $1}'
echo

if command -v pre-commit &>/dev/null; then
    git_dir="$(git rev-parse --git-dir 2>/dev/null)"
    if [ -z "$git_dir" ] || ! grep -q "pre-commit" "$git_dir/hooks/pre-commit" 2>/dev/null; then
        echo "WARNING: pre-commit hooks not installed. Run: pre-commit install -c .pre-commit-config.yaml"
    fi
fi

echo
echo "Generating workflow rulegraph SVG..."
echo

PYTHONHASHSEED=0 snakemake --rulegraph --forceall \
    --configfile .tests/unit/genbank_to_replicon/config/config.yaml \
    --directory .tests/unit/genbank_to_replicon/data \
    2>/dev/null | dot -Tsvg >workflow/rulegraph.svg

echo
echo 'grep -riHn version: > .version-map'
grep -riHne "version:\s" $(git ls-tree -r HEAD --name-only | grep -v "^\.") 2>/dev/null > .version-map
echo
